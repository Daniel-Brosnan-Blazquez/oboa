	<customidxs object-type="column">
		<object name="orchestration_configuration_uuid" index="7"/>
	</customidxs>
	<customidxs object-type="constraint">
		<object name="orchestrated_files_orchestration_configurations_fk" index="1"/>
	</customidxs></table>

<relationship name="orchestration_configurations_has_many_orchestrated_files" type="rel1n" layers="0"
	 src-col-pattern="orchestration_configuration_uuid"
	 pk-pattern="{dt}_pk" uq-pattern="{dt}_uq"
	 src-fk-pattern="orchestrated_files_orchestration_configurations_fk"
	 fk-idx-pattern="idx_orchestrated_files_orchestration_configuration_uuid"
	 custom-color="#3d7fc4"
	 src-table="oboa.orchestration_configurations"
	 dst-table="oboa.orchestrated_files"
	 src-required="false" dst-required="false"
	del-action="SET NULL"/>

<table name="orchestration_operations" layers="0" collapse-mode="2" max-obj-count="8" z-value="0">
