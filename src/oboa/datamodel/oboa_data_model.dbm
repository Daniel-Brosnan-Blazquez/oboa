		<type name="bool" length="0"/>
	</column>
	<column name="content" not-null="true">
		<type name="text" length="0"/>
	</column>
	<constraint name="orchestration_configurations_pk" type="pk-constr" table="oboa.orchestration_configurations">
		<columns names="orchestration_configuration_uuid" ref-type="src-columns"/>
	</constraint>
</table>

<table name="orchestrated_files" layers="0" collapse-mode="2" max-obj-count="10" z-value="0">
	<schema name="oboa"/>
	<role name="oboa"/>
	<position x="580" y="140"/>
	<column name="file_uuid" not-null="true">
